AGENT_URL=http://localhost:8123
OPENAI_API_KEY=

# <provider>:<model>. Providers understood by the agent: openai, anthropic, google.
# openai:gpt-6-luna is a real OpenAI model id (checked 2026-11-27). Chat
# Completions function-calling on Luna uses reasoning_effort=none.
# Point OPENAI_BASE_URL at any OpenAI-compatible server and keep the openai: prefix.
COPILOTKIT_AGENT_MODEL=openai:gpt-6-luna
# OPENAI_BASE_URL=

# Anthropic or Google need their LangChain packages installed in agent/ as well
# as the matching key. This playground image installs langchain-openai only.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional. Without it the runtime uses an in-memory runner. No CopilotKit Cloud
# account is required to run the playground.
# CPK_INTELLIGENCE_API_KEY=

# Optional tracing. Leave unset.
# LANGSMITH_API_KEY=
