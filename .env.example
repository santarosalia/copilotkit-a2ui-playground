AGENT_URL=http://localhost:8123

# Local vLLM (OpenAI-compatible). This is the default path.
# Qwen3 chat models tool-call with the hermes parser. See the README for the
# serve command. VLLM_API_KEY can stay dummy; vLLM does not check it.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=dummy
# Optional cap for one completion. A2UI trees are long JSON.
# VLLM_MAX_TOKENS=4096

# OpenAI fallback. Used only when VLLM_BASE_URL is unset.
# openai:gpt-6-luna is a real OpenAI model id (checked 2026-11-27). Chat
# Completions tool calls on Luna need reasoning_effort=none, which the agent sets.
# OPENAI_API_KEY=
# COPILOTKIT_AGENT_MODEL=openai:gpt-6-luna

# Optional. Without it the runtime uses an in-memory runner. No CopilotKit Cloud
# account is required to run the playground.
# CPK_INTELLIGENCE_API_KEY=

# Optional tracing. Leave unset.
# LANGSMITH_API_KEY=
